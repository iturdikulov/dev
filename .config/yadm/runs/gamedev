#!/usr/bin/env bash

source "$(dirname -- "${BASH_SOURCE[0]}")/utils.sh"

install_packages libsdl2-dev libglfw3-dev

# Raylib
# TODO: When libraylib-dev is available from configured apt sources (no extra repos needed),
# replace the pool block below with: install_packages libraylib-dev
# (direct .deb install avoids changing sources.list until then).
RAYLIB_POOL_BASE="https://deb.debian.org/debian/pool/main/r/raylib"
ARCH="$(dpkg --print-architecture)"

raylib_pool_index() {
    if command_exists curl; then
        curl -fsSL "${RAYLIB_POOL_BASE}/"
    elif command_exists wget; then
        wget -qO- "${RAYLIB_POOL_BASE}/"
    else
        log_error "curl or wget required to resolve latest raylib package"
        return 1
    fi
}

raylib_latest_version() {
    local arch="$1"
    local index="$2"

    printf '%s\n' "$index" |
        grep -oE "libraylib-dev_[^\"]+_${arch}\\.deb" |
        sed "s/libraylib-dev_//;s/_${arch}\\.deb//" |
        sort -V | tail -n 1
}

raylib_runtime_deb() {
    local arch="$1"
    local version="$2"
    local index="$3"

    printf '%s\n' "$index" |
        grep -oE "libraylib[0-9]+_${version}_${arch}\\.deb" |
        head -n 1
}

POOL_INDEX="$(raylib_pool_index)" || exit 1
RAYLIB_VERSION="$(raylib_latest_version "$ARCH" "$POOL_INDEX")"
RUNTIME_DEB="$(raylib_runtime_deb "$ARCH" "$RAYLIB_VERSION" "$POOL_INDEX")"

if [[ -z "$RAYLIB_VERSION" || -z "$RUNTIME_DEB" ]]; then
    log_error "Unable to resolve latest raylib packages for $ARCH"
    exit 1
fi

installed_version="$(dpkg-query -W -f='${Version}' libraylib-dev 2>/dev/null || true)"
if package_installed libraylib-dev && [[ "$installed_version" == "$RAYLIB_VERSION" ]]; then
    log_info "raylib $RAYLIB_VERSION ($ARCH) already installed"
else
    if package_installed libraylib-dev; then
        log_info "raylib ${installed_version:-unknown} installed; upgrading to $RAYLIB_VERSION"
    fi

    RAYLIB_TMP=$(mktemp -d) || exit 1
    RUN_DEB="$RAYLIB_TMP/$RUNTIME_DEB"
    DEV_DEB="$RAYLIB_TMP/libraylib-dev_${RAYLIB_VERSION}_${ARCH}.deb"
    download_file "${RAYLIB_POOL_BASE}/${RUNTIME_DEB}" "$RUN_DEB" || exit 1
    download_file "${RAYLIB_POOL_BASE}/libraylib-dev_${RAYLIB_VERSION}_${ARCH}.deb" "$DEV_DEB" || exit 1
    # mktemp -d is 0700; apt's pkgAcquire runs as _apt and must read local .deb paths.
    chmod a+rx -- "$RAYLIB_TMP"
    chmod a+r -- "$RUN_DEB" "$DEV_DEB"
    apt_update_if_needed
    sudo apt install -y "$RUN_DEB" "$DEV_DEB" || exit 1
    rm -rf "$RAYLIB_TMP"
fi
