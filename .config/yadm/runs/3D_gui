#!/usr/bin/env bash

source "$(dirname -- "${BASH_SOURCE[0]}")/utils.sh"

# F3D and FreeCAD
log_info "Setting up 3D tools..."
install_packages f3d # OptiX for Blender (libnvoptix1) comes with nvidia-open, see runs/nvidia

FREECAD_VERSION="1.1.1"
FREECAD_URL="https://github.com/FreeCAD/FreeCAD/releases/download/$FREECAD_VERSION/FreeCAD_$FREECAD_VERSION-Linux-x86_64-py311.AppImage"
FREECAD_APPIMAGE="$HOME/.local/bin/FreeCAD_$FREECAD_VERSION.AppImage"
FREECAD_BIN="$HOME/.local/bin/freecad"

ensure_directory "$HOME/.local/bin"
if [ "$(readlink -- "$FREECAD_BIN" 2>/dev/null)" = "$FREECAD_APPIMAGE" ] && [ -x "$FREECAD_APPIMAGE" ]; then
    log_info "FreeCAD $FREECAD_VERSION is already installed"
else
    download_file "$FREECAD_URL" "$FREECAD_APPIMAGE" || exit 1
    chmod +x "$FREECAD_APPIMAGE"
    ln -sf "$FREECAD_APPIMAGE" "$FREECAD_BIN"
fi

FREECAD_DESKTOP_CONTENT="[Desktop Entry]
Categories=Graphics;Science;Education;Engineering;X-CNC;
Comment=Feature based Parametric Modeler
Exec=env QT_AUTO_SCREEN_SCALE_FACTOR=1 $FREECAD_BIN - --single-instance %F
GenericName=CAD Application
Icon=$HOME/.local/bin/icons/freecad.svg
MimeType=application/x-extension-fcstd;model/obj;image/vnd.dwg;image/vnd.dxf;model/vnd.collada+xml;application/iges;model/iges;model/step;model/step+zip;model/stl;application/vnd.shp;model/vrml;
Name=FreeCAD
NoDisplay=false
Path=
PrefersNonDefaultGPU=false
StartupNotify=true
StartupWMClass=FreeCAD
Terminal=false
TerminalOptions=
Type=Application
X-KDE-SubstituteUID=false
X-KDE-Username="

create_desktop_entry "org.freecad.FreeCAD" "$FREECAD_DESKTOP_CONTENT"

# Function to install Blender
BLENDER_VERSION="5.1.1"
BLENDER_URL="https://download.blender.org/release/Blender5.1/blender-$BLENDER_VERSION-linux-x64.tar.xz"
BLENDER_ARCHIVE_FORMAT="tar.xz"
BLENDER_INSTALL_DIR="$HOME/.local/blender-$BLENDER_VERSION-linux-x64"

# Install Blender
DESKTOP_CONTENT="[Desktop Entry]
Version=$BLENDER_VERSION
Name=Blender
Comment=Free and open-source 3D creation suite
GenericName=Blender
Exec=$BLENDER_INSTALL_DIR/blender
Icon=$HOME/.local/bin/icons/blender.svg
Terminal=false
Type=Application
Categories=Graphics;Science
StartupNotify=true"

if [ -x "$BLENDER_INSTALL_DIR/blender" ] &&
    "$BLENDER_INSTALL_DIR/blender" --version | head -n 1 | grep -Fq "Blender $BLENDER_VERSION"; then
    log_info "Blender $BLENDER_VERSION is already installed"
    create_desktop_entry "blender" "$DESKTOP_CONTENT"
else
    install_archive "blender" "$BLENDER_URL" "$BLENDER_VERSION" "$BLENDER_INSTALL_DIR" "$BLENDER_ARCHIVE_FORMAT" &&
        create_desktop_entry "blender" "$DESKTOP_CONTENT"
fi

find_old_versions "$HOME/.local/" "blender-*" "blender-$BLENDER_VERSION*" "trash"

# Blender MCP (официальный сервер Blender Lab): клон репозитория + регистрация в pi
BLENDER_MCP_URL="https://projects.blender.org/lab/blender_mcp.git"
BLENDER_MCP_DIR="$HOME/.local/blender_mcp"
BLENDER_MCP_NAME="blender"

if git -C "$BLENDER_MCP_DIR" rev-parse --git-dir >/dev/null 2>&1; then
    log_info "Blender MCP already present; pulling updates"
    git -C "$BLENDER_MCP_DIR" pull --ff-only || log_warn "Blender MCP git pull failed (fix repo manually)"
elif [[ ! -e "$BLENDER_MCP_DIR" ]]; then
    git clone "$BLENDER_MCP_URL" "$BLENDER_MCP_DIR" || log_error "Blender MCP clone failed"
else
    log_error "$BLENDER_MCP_DIR exists and is not a git repository — remove or rename it, then re-run"
fi

if [[ -d "$BLENDER_MCP_DIR/mcp" ]]; then
    if command_exists pi && command_exists uv; then
        # pi mcp add заменяет запись, если она уже есть, — повторный запуск безопасен
        pi mcp add "$BLENDER_MCP_NAME" \
            --description "Официальный Blender Lab MCP: Python API Blender, сцена, документация" \
            -- uv --directory "$BLENDER_MCP_DIR/mcp" run blender-mcp ||
            log_warn "Failed to register Blender MCP in pi"
    else
        log_warn "pi or uv not found; skipping Blender MCP registration (see runs/05_python, runs/07_node)"
    fi

    # Собираем аддон в zip и ставим как расширение (переустановка обновляет его после git pull)
    BLENDER_MCP_ADDON_SRC="$BLENDER_MCP_DIR/addon/blender_mcp_addon"
    BLENDER_MCP_EXT_REPO="user_default"
    BLENDER_BIN="$BLENDER_INSTALL_DIR/blender"
    if [[ -x "$BLENDER_BIN" ]] && [[ -f "$BLENDER_MCP_ADDON_SRC/blender_manifest.toml" ]]; then
        BLENDER_MCP_BUILD_DIR="$(mktemp -d)"
        if "$BLENDER_BIN" --command extension build \
            --source-dir "$BLENDER_MCP_ADDON_SRC" --output-dir "$BLENDER_MCP_BUILD_DIR" >/dev/null &&
            "$BLENDER_BIN" --command extension install-file -r "$BLENDER_MCP_EXT_REPO" -e \
                "$BLENDER_MCP_BUILD_DIR"/*.zip; then
            log_info "Blender MCP add-on installed and enabled (restart Blender if it is running)"
        else
            log_warn "Failed to install Blender MCP add-on; install $BLENDER_MCP_ADDON_SRC manually"
        fi
        rm -rf -- "$BLENDER_MCP_BUILD_DIR"
    else
        log_warn "Blender or add-on manifest not found; skipping Blender MCP add-on install"
    fi
fi

log_info "3D setup completed successfully!"
