#!/usr/bin/env bash

source "$(dirname -- "${BASH_SOURCE[0]}")/utils.sh"

# Agents
# Allow scripts to run for opencode-ai package
npm config set allow-scripts=opencode-ai --location=user

# Ketch search
npm install -g ketch-cli
npm install -g opencode-ai@latest

# Pi coding agent (official npm; no lifecycle scripts required)
npm install -g --ignore-scripts @earendil-works/pi-coding-agent
pi install npm:@netandreus/pi-cursor-provider
pi install npm:pi-plan
pi install npm:pi-claude-bridge

# Ketch для pi: нативные инструменты ketch_* + research skill вместо MCP (см. plugins/pi в репо ketch)
pi install git:github.com/1broseidon/ketch
# Убираем старую MCP-запись, чтобы инструменты не дублировались
if pi mcp list --json 2>/dev/null | grep -q '"ketch"'; then
	pi mcp remove ketch
fi

# Скиллы агентов: ставим и обновляем через npx skills, в yadm не храним.
# Формат записи: "источник|скилл скилл ...". Повторный add подтягивает свежую версию.
# Во вложенных репах ancestor `.agents/skills` подхватывает ~/.pi/agent/extensions/ancestor-agents-skills.ts
global_skills=(
	"bsisduck/video-analyzer-skill|analyzing-video"
	"docker/skills|docker-build-strategies docker-compose-patterns docker-destructive-guardrails docker-project-foundations"
	"mattpocock/skills|ask-matt chief-of-staff claude-handoff code-review codebase-design diagnosing-bugs domain-modeling grill-me grill-with-docs grilling handoff implement implement-spec improve-codebase-architecture loop-me pr prototype research retro setup-matt-pocock-skills tdd teach to-questionnaire to-spec to-tickets triage wait-what wayfinder wizard writing-beats writing-for-agents writing-fragments writing-shape"
	"samber/cc-skills-golang|golang-testing"
	"vercel-labs/skills|find-skills"
)
az_skills=(
	"antfu/skills|pinia"
	"vuejs-ai/skills|vue-best-practices"
)
gamedev_skills=(
	"gamedev-skills/awesome-gamedev-agent-skills|ai-behavior-trees-utility-ai audio-design camera-systems create-game-assets game-ai game-feel game-ui-ux godot-2d-movement godot-3d-essentials godot-animation godot-audio godot-export godot-gdscript godot-gdscript-headless-testing godot-multiplayer godot-nodes-scenes godot-physics godot-resources godot-shaders godot-signals-groups godot-tilemap godot-ui-control input-systems level-design performance-optimization physics-tuning procedural-gen prototype-fast rpg save-systems shader-programming"
)

# $1 — "-g" или "" (проект в текущей папке), дальше записи списка
skills_add() {
	local scope=$1 entry source name args
	shift
	for entry in "$@"; do
		source=${entry%%|*}
		args=()
		for name in ${entry#*|}; do args+=(-s "$name"); done
		npx -y skills add "$source" $scope "${args[@]}" -y >/dev/null ||
			log_warn "skills: не удалось поставить $source в ${scope:-$PWD}"
	done
}

# $1 — папка проекта, дальше записи списка
project_skills_add() {
	local dir=$1
	shift
	if [[ ! -d "$dir" ]]; then
		log_warn "skills: нет $dir — проектные скиллы пропущены"
		return
	fi
	log_info "skills: $dir"
	(cd "$dir" && skills_add "" "$@")
	# CLI кладёт в корень skills-lock.json, .claude/skills и .agents/skills —
	# прячем локально через exclude, не трогая .gitignore проекта (если .git нет — нечего).
	if [[ -d "$dir/.git" ]]; then
		local pattern exclude="$dir/.git/info/exclude"
		for pattern in /skills-lock.json /.claude/skills/ /.agents/; do
			grep -qxF "$pattern" "$exclude" 2>/dev/null || echo "$pattern" >>"$exclude"
		done
	fi
}

log_info "skills: глобальные"
skills_add -g "${global_skills[@]}"
project_skills_add "$HOME/az" "${az_skills[@]}"
project_skills_add "$HOME/Media/games/gamedev" "${gamedev_skills[@]}"

# Cursor Agent CLI — latest version from https://cursor.com/install (no curl|bash)
case "$(dpkg --print-architecture)" in
	amd64) CURSOR_AGENT_ARCH=x64 ;;
	arm64) CURSOR_AGENT_ARCH=arm64 ;;
	*)
		log_warn "Cursor Agent CLI unsupported on $(dpkg --print-architecture); skipping"
		CURSOR_AGENT_ARCH=
		;;
esac

if [[ -n "$CURSOR_AGENT_ARCH" ]]; then
	CURSOR_AGENT_VERSION="$(
		curl -fsSL https://cursor.com/install |
			grep -oE 'lab/[0-9]{4}\.[0-9]{2}\.[0-9]{2}-[a-f0-9]+' |
			head -1 |
			cut -d/ -f2
	)"
	if [[ -z "$CURSOR_AGENT_VERSION" ]]; then
		log_error "Could not parse Cursor Agent version from https://cursor.com/install"
		exit 1
	fi

	CURSOR_AGENT_DIR="$HOME/.local/share/cursor-agent/versions/$CURSOR_AGENT_VERSION"
	CURSOR_AGENT_BIN="$CURSOR_AGENT_DIR/cursor-agent"
	CURSOR_AGENT_URL="https://downloads.cursor.com/lab/${CURSOR_AGENT_VERSION}/linux/${CURSOR_AGENT_ARCH}/agent-cli-package.tar.gz"

	if [[ -x "$CURSOR_AGENT_BIN" ]]; then
		log_info "cursor-agent $CURSOR_AGENT_VERSION already installed; skipping download"
	else
		log_info "Installing cursor-agent $CURSOR_AGENT_VERSION"
		tmp_archive="$(mktemp)"
		tmp_extract="$(mktemp -d)"
		trap 'rm -rf -- "$tmp_archive" "$tmp_extract"' EXIT
		download_file "$CURSOR_AGENT_URL" "$tmp_archive"
		tar --strip-components=1 -xzf "$tmp_archive" -C "$tmp_extract"
		ensure_directory "$(dirname "$CURSOR_AGENT_DIR")"
		rm -rf -- "$CURSOR_AGENT_DIR"
		mv "$tmp_extract" "$CURSOR_AGENT_DIR"
		rm -f -- "$tmp_archive"
		trap - EXIT
	fi

	ensure_directory "$HOME/.local/bin"
	ln -sfn "$CURSOR_AGENT_BIN" "$HOME/.local/bin/cursor-agent"
	ln -sfn "$CURSOR_AGENT_BIN" "$HOME/.local/bin/agent"
fi

