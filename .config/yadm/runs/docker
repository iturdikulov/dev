#!/usr/bin/env bash

source "$(dirname -- "${BASH_SOURCE[0]}")/utils.sh"

## Apt
## https://docs.docker.com/engine/install/debian/

docker_keyring="/etc/apt/keyrings/docker.asc"
docker_source="/etc/apt/sources.list.d/docker.list"
docker_repo="deb [arch=$(dpkg --print-architecture) signed-by=${docker_keyring}] https://download.docker.com/linux/debian $(. /etc/os-release && echo "$VERSION_CODENAME") stable"
docker_repo_added=0

install_packages ca-certificates curl

if [ ! -f "$docker_keyring" ]; then
  log_info "Adding Docker APT key..."
  sudo install -m 0755 -d /etc/apt/keyrings
  sudo curl -fsSL https://download.docker.com/linux/debian/gpg -o "$docker_keyring"
  sudo chmod a+r "$docker_keyring"
  docker_repo_added=1
else
  log_info "Docker APT key is already installed"
fi

if [ ! -f "$docker_source" ] || ! grep -Fxq "$docker_repo" "$docker_source"; then
  log_info "Adding Docker APT repository..."
  echo "$docker_repo" | sudo tee "$docker_source" > /dev/null
  docker_repo_added=1
else
  log_info "Docker APT repository is already configured"
fi

if [ "$docker_repo_added" -eq 1 ]; then
  sudo apt-get update
fi

# NVIDIA Container Toolkit from the CUDA debian13 repo (same as runs/nvidia)
if ! package_installed cuda-keyring; then
  download_file https://developer.download.nvidia.com/compute/cuda/repos/debian13/x86_64/cuda-keyring_1.1-1_all.deb /tmp/cuda-keyring.deb
  sudo dpkg -i /tmp/cuda-keyring.deb && rm -f /tmp/cuda-keyring.deb
  sudo apt-get update
fi

# Drop the duplicate libnvidia-container apt source if present
if [ -f /etc/apt/sources.list.d/nvidia-container-toolkit.list ]; then
  log_info "Removing nvidia-container-toolkit.list (packages come from CUDA repo)"
  sudo rm -f /etc/apt/sources.list.d/nvidia-container-toolkit.list
  sudo apt-get update
fi
sudo rm -f /usr/share/keyrings/nvidia-container-toolkit-keyring.gpg

install_packages nvidia-container-toolkit

# Install
install_packages docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

# Register the NVIDIA runtime without making it Docker's default. GPU access is
# requested explicitly by the Compose services that need it.
if ! command -v nvidia-ctk >/dev/null 2>&1; then
  log_error "nvidia-ctk is unavailable after installing nvidia-container-toolkit"
  exit 1
fi
sudo nvidia-ctk runtime configure --runtime=docker
sudo systemctl restart docker
if ! docker info --format '{{json .Runtimes}}' | grep -q '"nvidia"'; then
  log_error "Docker did not register the NVIDIA runtime"
  exit 1
fi

# Post install
sudo usermod -aG docker "$USER"

# Monthly unused Docker cleanup (1st of month, 00:00). until=720h (~30d) applies to
# containers/images/networks; --volumes still removes all unused volumes.
docker_bin="$(command -v docker)"
docker_prune_log="/tmp/docker-prune.log"
docker_prune_cron="0 0 1 * * ${docker_bin} system prune -a -f --filter \"until=720h\" >>${docker_prune_log} 2>&1"
current_root_cron="$(sudo crontab -l 2>/dev/null || true)"
if printf '%s\n' "$current_root_cron" | grep -qF -- "system prune -a --volumes"; then
  log_info "Docker prune cron already present"
else
  log_info "Registering monthly Docker prune cron → ${docker_prune_log}"
  printf '%s\n%s\n' "$current_root_cron" "$docker_prune_cron" | sed '/^$/d' | sudo crontab -
fi

# Lazydocker
go install github.com/jesseduffield/lazydocker@latest

# Devcontainers
npm install -g @devcontainers/cli
