#!/usr/bin/env bash

source "$(dirname -- "${BASH_SOURCE[0]}")/utils.sh"

if ! package_installed microsoft-edge-stable; then
    install_packages ca-certificates curl gnupg

    sudo install -m 0755 -d /etc/apt/keyrings
    curl -fsSL https://packages.microsoft.com/keys/microsoft.asc \
        | gpg --dearmor \
        | sudo tee /etc/apt/keyrings/microsoft-edge.gpg >/dev/null

    echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/microsoft-edge.gpg] https://packages.microsoft.com/repos/edge stable main" \
        | sudo tee /etc/apt/sources.list.d/microsoft-edge-stable.list >/dev/null

    sudo apt-get update
    ensure_directory "$(dirname "$APT_UPDATE_STAMP")"
    date +%s >"$APT_UPDATE_STAMP"
fi

install_packages microsoft-edge-stable

mkdir -p "$HOME/.local/share/applications"
rm -f "$HOME/.local/share/applications/microsoft-edge.desktop"
cat > "$HOME/.local/share/applications/com.microsoft.Edge.desktop" << EOF
[Desktop Entry]
Version=1.0
Name=Microsoft Edge
GenericName=Web Browser
Comment=Access the Internet
Exec=/home/inom/.local/bin/microsoft-edge %U
Icon=microsoft-edge
Terminal=false
Type=Application
Categories=Network;WebBrowser;
MimeType=application/pdf;application/rdf+xml;application/rss+xml;application/xhtml+xml;application/xhtml_xml;application/xml;image/gif;image/jpeg;image/png;image/webp;text/html;text/xml;x-scheme-handler/http;x-scheme-handler/https;x-scheme-handler/microsoft-edge;x-scheme-handler/chromium;
NoDisplay=false
StartupNotify=true
Actions=new-window;new-private-window;ltms-debug;

[Desktop Action new-window]
Name=New Window
Exec=/usr/bin/microsoft-edge-stable

[Desktop Action new-private-window]
Name=New InPrivate Window
Exec=/usr/bin/microsoft-edge-stable --inprivate

[Desktop Action ltms-debug]
Name=LTMS Debug
Exec=/usr/bin/microsoft-edge-stable --remote-debugging-port=9222 --user-data-dir=/home/inom/.local/state/nvim/microsoft-edge-ltms-debug --no-first-run --no-default-browser-check --new-window http://localhost:6573
EOF

update-desktop-database "$HOME/.local/share/applications/"

# Телемост — окно приложения (--app) без адресной строки и вкладок.
# Имя файла и StartupWMClass повторяют Wayland app_id окна Edge
# (msedge-<хост>__-<профиль>): по нему GNOME находит иконку и группирует окно,
# по нему же поднимает окно run-or-raise (Super+Y). Метку «Y» в углу иконки
# рисует runs/dock_icons.py — он берёт её из той же строки shortcuts.conf.
TELEMOST_ID="msedge-telemost.yandex.ru__-Default"
TELEMOST_ICON="$HOME/.local/share/icons/telemost.png"

ensure_directory "$(dirname "$TELEMOST_ICON")"
curl -fsSL -o "$TELEMOST_ICON" \
    "https://yastatic.net/s3/chat-static/favicons/tm/apple-touch-icon-512.png" \
    || log_warn "Telemost icon download failed — keeping $TELEMOST_ICON"

create_desktop_entry "$TELEMOST_ID" "[Desktop Entry]
Version=1.0
Type=Application
Name=Telemost
GenericName=Video meetings
GenericName[ru]=Видеовстречи
Comment=Yandex Telemost in an app-like window without browser UI
Comment[ru]=Яндекс Телемост в окне приложения, без браузерного интерфейса
Name[ru]=Телемост
Exec=/usr/bin/microsoft-edge-stable --app=\"https://telemost.yandex.ru/\" --start-maximized --no-first-run --no-default-browser-check
Icon=$TELEMOST_ICON
Terminal=false
Categories=Network;Chat;VideoConference;
Keywords=telemost;conference;meeting;call;
Keywords[ru]=телемост;видеозвонок;созвон;
StartupNotify=true
StartupWMClass=$TELEMOST_ID"
