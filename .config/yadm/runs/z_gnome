#!/usr/bin/env bash

source "$(dirname -- "${BASH_SOURCE[0]}")/utils.sh"

if ! command_exists gsettings; then
    log_warn "gsettings not found — skipping GNOME preferences"
    exit 0
fi

if [[ "${XDG_CURRENT_DESKTOP:-}" != *GNOME* ]]; then
    log_warn "Not in a GNOME session (XDG_CURRENT_DESKTOP=${XDG_CURRENT_DESKTOP:-unset}); applying settings anyway"
fi

desktop_file_path() {
    local desktop="$1"
    if [[ -f "$HOME/.local/share/applications/$desktop" ]]; then
        printf '%s\n' "$HOME/.local/share/applications/$desktop"
    elif [[ -f "/usr/share/applications/$desktop" ]]; then
        printf '%s\n' "/usr/share/applications/$desktop"
    else
        return 1
    fi
}

set_mime_default() {
    local mime="$1"
    local desktop="$2"

    if ! desktop_file_path "$desktop" >/dev/null; then
        log_warn "Missing $desktop — cannot set default for $mime"
        return 0
    fi

    local current
    current="$(xdg-mime query default "$mime" 2>/dev/null || true)"
    if [[ "$current" == "$desktop" ]]; then
        return 0
    fi

    xdg-mime default "$desktop" "$mime"
    log_info "$mime -> $desktop"
}

set_mimes_from_desktop() {
    local desktop="$1"
    local path mime_line mime

    path="$(desktop_file_path "$desktop")" || {
        log_warn "Desktop file not found: $desktop"
        return 0
    }

    mime_line="$(grep -m1 '^MimeType=' "$path" | cut -d= -f2-)"
    if [[ -z "$mime_line" ]]; then
        log_warn "No MimeType in $desktop"
        return 0
    fi

    IFS=';' read -r -a mimes <<< "$mime_line"
    for mime in "${mimes[@]}"; do
        [[ -n "$mime" ]] || continue
        set_mime_default "$mime" "$desktop"
    done
}

set_gsetting_if_different() {
    local schema="$1"
    local key="$2"
    local value="$3"
    local current quoted

    quoted="'$value'"
    current="$(gsettings get "$schema" "$key" 2>/dev/null || true)"
    if [[ "$current" == "$quoted" ]]; then
        return 0
    fi

    gsettings set "$schema" "$key" "$value"
    log_info "$schema $key -> $quoted"
}

set_gsetting_bool_if_different() {
    local schema="$1"
    local key="$2"
    local value="$3"
    local current

    current="$(gsettings get "$schema" "$key" 2>/dev/null || true)"
    if [[ "$current" == "$value" ]]; then
        return 0
    fi

    gsettings set "$schema" "$key" "$value"
    log_info "$schema $key -> $value"
}

set_gsetting_uint_if_different() {
    local schema="$1"
    local key="$2"
    local value="$3"
    local expected="uint32 $value"
    local current

    current="$(gsettings get "$schema" "$key" 2>/dev/null || true)"
    if [[ "$current" == "$expected" ]]; then
        return 0
    fi

    gsettings set "$schema" "$key" "$expected"
    log_info "$schema $key -> $expected"
}

set_audio_toggle_shortcut() {
    local path="/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom0/"
    local schema="org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:$path"
    local current target

    current="$(gsettings get org.gnome.settings-daemon.plugins.media-keys custom-keybindings 2>/dev/null || echo '@as []')"
    if [[ "$current" != *"$path"* ]]; then
        if [[ "$current" == "@as []" || "$current" == "[]" ]]; then
            target="['$path']"
        else
            target="${current%]}, '$path']"
        fi
        gsettings set org.gnome.settings-daemon.plugins.media-keys custom-keybindings "$target"
        log_info "Added GNOME custom shortcut path $path"
    fi

    set_gsetting_if_different "$schema" name 'Переключить аудиовыход'
    set_gsetting_if_different "$schema" command "$HOME/.local/scripts/toggle_audio.sh"
    set_gsetting_if_different "$schema" binding '<Super><Shift>a'
}

set_vpn_toggle_shortcut() {
    local path="/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom1/"
    local schema="org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:$path"
    local current target
    local command="/bin/bash -c 'active=\$(nmcli -t -f NAME,TYPE connection show --active | awk -F: '\''\$2==\"vpn\" {print \$1; exit}'\''); if [[ -n \$active ]]; then nmcli connection down \"\$active\"; else vpn=\$(nmcli -t -f NAME,TYPE connection show | awk -F: '\''\$2==\"vpn\" {name=\$1} END {print name}'\''); [[ -n \$vpn ]] && nmcli connection up \"\$vpn\"; fi'"

    current="$(gsettings get org.gnome.settings-daemon.plugins.media-keys custom-keybindings 2>/dev/null || echo '@as []')"
    if [[ "$current" != *"$path"* ]]; then
        if [[ "$current" == "@as []" || "$current" == "[]" ]]; then
            target="['$path']"
        else
            target="${current%]}, '$path']"
        fi
        gsettings set org.gnome.settings-daemon.plugins.media-keys custom-keybindings "$target"
        log_info "Added GNOME custom shortcut path $path"
    fi

    set_gsetting_if_different "$schema" name 'Переключить VPN'
    set_gsetting_if_different "$schema" command "$command"
    set_gsetting_if_different "$schema" binding '<Super><Shift>v'
}

set_vt_bounce_hotkey() {
    # Evdev hotkeys — work when GNOME shortcuts / the screen are dead.
    # Super+Esc / ScrollLock → VT bounce; Ctrl+Alt+Backspace → reboot
    # (needs /etc/sudoers.d/reboot-hotkey from reboot-hotkey.sudoers).
    local unit_dir="$HOME/.config/systemd/user"
    local unit="$unit_dir/vt-bounce-hotkey.service"
    mkdir -p "$unit_dir"
    cat >"$unit" <<EOF
[Unit]
Description=Recovery hotkeys via evdev (VT bounce / reboot)
After=default.target

[Service]
Type=simple
ExecStart=$HOME/.local/scripts/vt-bounce-hotkey.py
Restart=on-failure
RestartSec=1

[Install]
WantedBy=default.target
EOF
    systemctl --user daemon-reload
    systemctl --user enable --now vt-bounce-hotkey.service
    log_info "vt-bounce-hotkey.service enabled (Super+Esc bounce, Ctrl+Alt+Backspace reboot)"
}

set_xkb_ctrl_nocaps() {
    local current target raw_output
    local -a kept=()
    local -a raw=()
    local opt

    raw_output="$(gsettings get org.gnome.desktop.input-sources xkb-options)"
    if [[ "$raw_output" != "@as []" && "$raw_output" != "[]" ]]; then
        mapfile -t raw < <(printf '%s' "$raw_output" | tr -d "[]'" | tr ',' '\n' | sed '/^$/d')
    fi

    for opt in "${raw[@]}"; do
        opt="${opt#"${opt%%[![:space:]]*}"}"
        opt="${opt%"${opt##*[![:space:]]}"}"
        [[ "$opt" == @as ]] && continue
        [[ "$opt" == ctrl:nocaps ]] && continue
        [[ "$opt" == ctrl:* || "$opt" == caps:* ]] && continue
        [[ -n "$opt" ]] && kept+=("$opt")
    done

    if ((${#kept[@]} == 0)); then
        target="['ctrl:nocaps']"
    else
        target="['ctrl:nocaps'"
        for opt in "${kept[@]}"; do
            target+=", '$opt'"
        done
        target+="]"
    fi

    current="$(gsettings get org.gnome.desktop.input-sources xkb-options)"
    if [[ "$current" == "$target" ]]; then
        log_info "xkb-options already set to ctrl:nocaps"
        return 0
    fi

    gsettings set org.gnome.desktop.input-sources xkb-options "$target"
    log_info "xkb-options -> $target"
}

set_input_source_russian() {
    local current target

    current="$(gsettings get org.gnome.desktop.input-sources sources 2>/dev/null || echo '@as []')"
    if [[ "$current" == *"('xkb', 'ru')"* ]]; then
        log_info "Russian input source already configured"
        return 0
    fi

    if [[ "$current" == "@as []" || "$current" == "[]" ]]; then
        target="[('xkb', 'us'), ('xkb', 'ru')]"
    else
        target="${current%]}"
        target+=", ('xkb', 'ru')]"
    fi

    gsettings set org.gnome.desktop.input-sources sources "$target"
    log_info "input-sources -> $target"
}

find_telegram_desktop() {
    local candidate path newest="" newest_name=""

    for candidate in org.telegram.desktop telegram.desktop; do
        if desktop_file_path "$candidate" >/dev/null; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done

    while IFS= read -r path; do
        [[ -f "$path" ]] || continue
        if [[ -z "$newest" || "$path" -nt "$newest" ]]; then
            newest="$path"
            newest_name="$(basename "$path")"
        fi
    done < <(find "$HOME/.local/share/applications" /usr/share/applications -maxdepth 1 \
        \( -name 'org.telegram.desktop*.desktop' -o -name 'telegram.desktop' \) 2>/dev/null)

    if [[ -n "$newest_name" ]]; then
        printf '%s\n' "$newest_name"
        return 0
    fi

    return 1
}

find_godot_desktop() {
    local candidate path newest="" newest_name=""

    for candidate in godot.desktop; do
        if desktop_file_path "$candidate" >/dev/null; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done

    while IFS= read -r path; do
        [[ -f "$path" ]] || continue
        if [[ -z "$newest" || "$path" -nt "$newest" ]]; then
            newest="$path"
            newest_name="$(basename "$path")"
        fi
    done < <(find "$HOME/.local/share/applications" /usr/share/applications -maxdepth 1 \
        -name 'Godot_v*_mono_linux_x86_64.desktop' 2>/dev/null)

    if [[ -n "$newest_name" ]]; then
        printf '%s\n' "$newest_name"
        return 0
    fi

    return 1
}

# Telegram names its .desktop org.telegram.desktop._<hash>.desktop; the
# hash differs per install, so resolve the newest match at runtime.
find_telegram_desktop() {
    local path newest=""

    while IFS= read -r path; do
        if [[ -z "$newest" || "$path" -nt "$newest" ]]; then
            newest="$path"
        fi
    done < <(find "$HOME/.local/share/applications" /usr/share/applications -maxdepth 1 \
        -name 'org.telegram.desktop*.desktop' 2>/dev/null)

    [[ -n "$newest" ]] || return 1
    basename "$newest"
}

set_favorite_apps() {
    # Order mirrored from live dock (gsettings org.gnome.shell favorite-apps), 2026-11-01.
    # Win+1…0/-/= bindings live in ~/.config/run-or-raise/shortcuts.conf (yadm).
    # Godot desktop basename can change — resolve at runtime.
    local -a favorites=(
        com.mitchellh.ghostty.desktop
        microsoft-edge.desktop
        com.mitchellh.ghostty.wiki.desktop
        md.obsidian.Obsidian.desktop
        sioyek.desktop
        thunderbird.desktop
    )
    local godot_desktop current target desktop

    if godot_desktop="$(find_godot_desktop)"; then
        favorites+=("$godot_desktop")
    else
        log_warn "Godot desktop not found — skipping pin"
    fi

    favorites+=(
        blender.desktop
        org.kde.krita.desktop
        org.nomacs.ImageLounge.desktop
        mpv.desktop
        spotify.desktop
    )

    local telegram_desktop
    if telegram_desktop="$(find_telegram_desktop)"; then
        favorites+=("$telegram_desktop")
    else
        log_warn "Telegram desktop not found — skipping pin"
    fi

    favorites+=(
        org.zealdocs.zeal.desktop
        org.freecad.FreeCAD.desktop
    )

    for desktop in "${favorites[@]}"; do
        if ! desktop_file_path "$desktop" >/dev/null; then
            log_warn "Favorite desktop missing (pin anyway): $desktop"
        fi
    done

    target="["
    for desktop in "${favorites[@]}"; do
        [[ "$target" != "[" ]] && target+=", "
        target+="'$desktop'"
    done
    target+="]"

    current="$(gsettings get org.gnome.shell favorite-apps 2>/dev/null || true)"
    if [[ "$current" == "$target" ]]; then
        log_info "favorite-apps already up to date"
        return 0
    fi

    gsettings set org.gnome.shell favorite-apps "$target"
    log_info "favorite-apps -> ${#favorites[@]} pins"
}

gnome_shell_version() {
    gnome-shell --version 2>/dev/null | awk '{print $3}'
}

extension_is_installed() {
    [[ -f "$HOME/.local/share/gnome-shell/extensions/$1/metadata.json" ]]
}

gsettings_string_array() {
    local key="$1"
    local -n _out="$2"
    local item raw

    _out=()
    raw="$(gsettings get org.gnome.shell "$key" 2>/dev/null || echo '@as []')"
    if [[ "$raw" == "@as []" || "$raw" == "[]" ]]; then
        return 0
    fi

    mapfile -t _out < <(printf '%s' "$raw" | tr -d "[]'" | tr ',' '\n' | sed '/^$/d')
    for i in "${!_out[@]}"; do
        item="${_out[$i]}"
        item="${item#"${item%%[![:space:]]*}"}"
        item="${item%"${item##*[![:space:]]}"}"
        _out[$i]="$item"
    done
}

gsettings_write_string_array() {
    local key="$1"
    shift
    local -a items=("$@")
    local value="["

    if ((${#items[@]} == 0)); then
        gsettings set org.gnome.shell "$key" "@as []"
        return 0
    fi

    for item in "${items[@]}"; do
        [[ "$value" != "[" ]] && value+=", "
        value+="'$item'"
    done
    value+="]"
    gsettings set org.gnome.shell "$key" "$value"
}

array_contains() {
    local needle="$1"
    shift
    local item
    for item in "$@"; do
        [[ "$item" == "$needle" ]] && return 0
    done
    return 1
}

array_remove() {
    local needle="$1"
    local -n _arr="$2"
    local -a kept=()
    local item

    for item in "${_arr[@]}"; do
        [[ "$item" == "$needle" ]] && continue
        kept+=("$item")
    done
    _arr=("${kept[@]}")
}

set_extension_enabled_gsettings() {
    local uuid="$1"
    local state="$2"
    local -a enabled=() disabled=()
    local changed=0

    gsettings_string_array enabled-extensions enabled
    gsettings_string_array disabled-extensions disabled

    case "$state" in
    enable)
        array_remove "$uuid" disabled
        if ! array_contains "$uuid" "${enabled[@]}"; then
            enabled+=("$uuid")
            changed=1
        fi
        ;;
    disable)
        array_remove "$uuid" enabled
        if ! array_contains "$uuid" "${disabled[@]}"; then
            disabled+=("$uuid")
            changed=1
        fi
        ;;
    esac

    ((changed)) || return 0

    gsettings_write_string_array enabled-extensions "${enabled[@]}"
    gsettings_write_string_array disabled-extensions "${disabled[@]}"
    log_info "${state^}d $uuid via gsettings"
    mark_extensions_changed
}

mark_extensions_changed() {
    gnome_extensions_changed=1
}

restart_gnome_shell_if_needed() {
    if ((gnome_extensions_changed == 0)); then
        return 0
    fi
    if [[ "${YADM_SKIP_SHELL_RESTART:-}" == 1 ]]; then
        log_warn "Extensions changed; skipping GNOME Shell restart (YADM_SKIP_SHELL_RESTART=1)"
        return 0
    fi
    if [[ "${XDG_CURRENT_DESKTOP:-}" != *GNOME* ]]; then
        log_warn "Extensions changed; log in to GNOME to load them"
        return 0
    fi

    log_info "Restarting GNOME Shell to apply extensions..."
    if busctl --user call org.gnome.Shell /org/gnome/Shell org.gnome.Shell Eval s 'Meta.restart("Applying yadm extensions")' &>/dev/null \
        || gdbus call --session --dest org.gnome.Shell --object-path /org/gnome/Shell \
            --method org.gnome.Shell.Eval 'Meta.restart("Applying yadm extensions")' &>/dev/null; then
        log_info "GNOME Shell restart requested"
        return 0
    fi

    log_warn "Could not restart GNOME Shell — log out and back in to load extensions"
}

install_gnome_extension() {
    local uuid="$1"
    local shell_version info version_tag target_version installed_version tmp url uuid_enc

    shell_version="$(gnome_shell_version)"
    if [[ -z "$shell_version" ]]; then
        log_warn "Cannot detect GNOME Shell version — skip $uuid"
        return 0
    fi

    # extensions.gnome.org expects @ → %40 in the uuid query/path.
    uuid_enc="$(printf '%s' "$uuid" | sed 's/@/%40/g')"

    if ! info="$(curl -fsSL "https://extensions.gnome.org/extension-info/?uuid=${uuid_enc}&shell_version=${shell_version}")"; then
        log_warn "Failed to fetch extension info for $uuid"
        return 0
    fi

    version_tag="$(jq -r '.version_tag // empty' <<< "$info")"
    target_version="$(jq -r '.version // empty' <<< "$info")"
    if [[ -z "$version_tag" ]]; then
        log_warn "No compatible $uuid for GNOME Shell $shell_version"
        return 0
    fi

    if extension_is_installed "$uuid"; then
        installed_version="$(jq -r '.version // empty' "$HOME/.local/share/gnome-shell/extensions/$uuid/metadata.json" 2>/dev/null || true)"
        if [[ "$installed_version" == "$target_version" ]]; then
            log_info "$uuid v$target_version already installed"
            return 0
        fi
        log_info "Updating $uuid ($installed_version -> $target_version)"
    fi

    url="https://extensions.gnome.org/download-extension/${uuid_enc}.shell-extension.zip?version_tag=${version_tag}"
    tmp="$(mktemp --suffix=.shell-extension.zip)"
    if ! curl -fsSL -o "$tmp" "$url"; then
        rm -f "$tmp"
        log_warn "Failed to download $uuid"
        return 0
    fi

    if ! gnome-extensions install -f "$tmp"; then
        rm -f "$tmp"
        log_warn "Failed to install $uuid"
        return 0
    fi
    rm -f "$tmp"

    if ! extension_is_installed "$uuid"; then
        log_warn "Install reported success but $uuid is missing on disk"
        return 0
    fi

    log_info "Installed $uuid v$target_version"
    mark_extensions_changed
}

set_extension_enabled() {
    local uuid="$1"
    local state="$2"

    if ! extension_is_installed "$uuid"; then
        log_warn "Extension not installed: $uuid"
        return 0
    fi

    if gnome-extensions list 2>/dev/null | grep -qxF "$uuid"; then
        case "$state" in
        enable)
            if gnome-extensions list --enabled 2>/dev/null | grep -qxF "$uuid"; then
                return 0
            fi
            if gnome-extensions enable "$uuid" 2>/dev/null; then
                log_info "Enabled $uuid"
                mark_extensions_changed
                return 0
            fi
            ;;
        disable)
            if gnome-extensions list --disabled 2>/dev/null | grep -qxF "$uuid"; then
                return 0
            fi
            if gnome-extensions disable "$uuid" 2>/dev/null; then
                log_info "Disabled $uuid"
                mark_extensions_changed
                return 0
            fi
            ;;
        esac
    fi

    set_extension_enabled_gsettings "$uuid" "$state"
}

setup_gnome_extensions() {
    gnome_extensions_changed=0

    install_packages gnome-shell-extension-manager

    if ! command_exists gnome-extensions; then
        log_warn "gnome-extensions not found — skipping shell extensions"
        return 0
    fi

    if ! command_exists jq; then
        install_packages jq
    fi

    local uuid
    for uuid in \
        appindicatorsupport@rgcjonas.gmail.com \
        run-or-raise@edvard.cz \
        color-picker@tuberry \
        copyous@boerdereinar.dev \
        deja-window@mcast.gnomext.com \
        draw-on-gnome@daveprowse.github.io \
        Shortcuts@kyle.aims.ac.za; do
        install_gnome_extension "$uuid"
    done

    set_extension_enabled appindicatorsupport@rgcjonas.gmail.com enable
    set_extension_enabled run-or-raise@edvard.cz enable
    set_extension_enabled color-picker@tuberry enable
    set_extension_enabled copyous@boerdereinar.dev disable
    # Remembers monitor/size/maximize per WM_CLASS (needed for Ghostty az-right on DP-2).
    set_extension_enabled deja-window@mcast.gnomext.com enable
    # Annotate desktop: Super+Alt+D (https://github.com/daveprowse/Draw-On-Gnome).
    set_extension_enabled draw-on-gnome@daveprowse.github.io enable
    # Keyboard shortcuts cheat sheet: Ctrl+Alt+Super+S by default.
    set_extension_enabled Shortcuts@kyle.aims.ac.za enable
    ensure_run_or_raise_dbus
    ensure_deja_window_rules
    restart_gnome_shell_if_needed
}

# Enables run-or-raise DBus Call (raise existing window by class without re-Exec).
ensure_run_or_raise_dbus() {
    local uuid="run-or-raise@edvard.cz"
    local src="$HOME/.local/share/gnome-shell/extensions/$uuid/schemas/org.gnome.shell.extensions.run-or-raise.gschema.xml"
    local dest_dir="$HOME/.local/share/glib-2.0/schemas"
    local dest="$dest_dir/org.gnome.shell.extensions.run-or-raise.gschema.xml"
    local schema="org.gnome.shell.extensions.run-or-raise"

    if [[ ! -f "$src" ]]; then
        log_warn "run-or-raise schema missing — skip dbus enable"
        return 0
    fi

    ensure_directory "$dest_dir"
    if [[ ! -f "$dest" ]] || ! cmp -s "$src" "$dest"; then
        cp "$src" "$dest"
        glib-compile-schemas "$dest_dir"
    fi

    if ! gsettings list-schemas 2>/dev/null | grep -qxF "$schema"; then
        log_warn "run-or-raise schema not visible — skip dbus enable"
        return 0
    fi

    if [[ "$(gsettings get "$schema" dbus 2>/dev/null || true)" == "true" ]]; then
        log_info "run-or-raise dbus already enabled"
        return 0
    fi

    gsettings set "$schema" dbus true
    log_info "run-or-raise dbus enabled (toggle extension once to export D-Bus)"
}

# Deja ships a private schema; compile into user glib store so gsettings works.
ensure_deja_window_schema() {
    local uuid="deja-window@mcast.gnomext.com"
    local src="$HOME/.local/share/gnome-shell/extensions/$uuid/schemas/org.gnome.shell.extensions.deja-window.gschema.xml"
    local dest_dir="$HOME/.local/share/glib-2.0/schemas"
    local dest="$dest_dir/org.gnome.shell.extensions.deja-window.gschema.xml"

    if [[ ! -f "$src" ]]; then
        log_warn "Deja Window schema missing ($src) — skip rule setup"
        return 1
    fi

    ensure_directory "$dest_dir"
    if [[ ! -f "$dest" ]] || ! cmp -s "$src" "$dest"; then
        cp "$src" "$dest"
        glib-compile-schemas "$dest_dir"
        log_info "Compiled Deja Window gsettings schema"
    fi
    return 0
}

# Apply ~/.config/deja-window/rules.json (yadm) → gsettings. Overwrites
# window-app-configs; window-app-states (geometry) stay runtime-only.
# Telegram class embeds a per-install hash → regex in the rules file.
ensure_deja_window_rules() {
    local schema="org.gnome.shell.extensions.deja-window"
    local rules="$HOME/.config/deja-window/rules.json"

    ensure_deja_window_schema || return 0

    if [[ ! -f "$rules" ]]; then
        log_warn "Deja rules missing ($rules) — skip"
        return 0
    fi

    if ! gsettings list-schemas 2>/dev/null | grep -qxF "$schema"; then
        log_warn "Deja Window schema not visible to gsettings — skip rules"
        return 0
    fi

    python3 -I - "$schema" "$rules" <<'PY'
import ast, json, subprocess, sys
from pathlib import Path

schema, path = sys.argv[1], Path(sys.argv[2])
desired = json.loads(path.read_text())
raw = subprocess.check_output(
    ["gsettings", "get", schema, "window-app-configs"], text=True).strip()
current = json.loads(ast.literal_eval(raw))
if current == desired:
    print("up to date")
else:
    payload = json.dumps(desired, ensure_ascii=False)
    subprocess.check_call(["gsettings", "set", schema, "window-app-configs", payload])
    print(f"applied {len(desired)} rules from {path}")
PY
}

log_info "Applying GNOME preferences..."

set_xkb_ctrl_nocaps
set_input_source_russian
set_gsetting_if_different org.gnome.desktop.interface color-scheme prefer-dark
set_gsetting_if_different org.gnome.desktop.default-applications.office.calendar exec 'thunderbird -calendar'
set_gsetting_bool_if_different org.gnome.desktop.notifications show-in-lock-screen false
set_gsetting_bool_if_different org.gnome.desktop.interface enable-hot-corners false
set_gsetting_bool_if_different org.gnome.desktop.screensaver lock-enabled true
# Default true: auto-download + install non-reboot updates (locks dpkg vs apt).
set_gsetting_bool_if_different org.gnome.software download-updates false
# Never blank the screen on idle; suspend after 1h20 instead.
set_gsetting_uint_if_different org.gnome.desktop.session idle-delay 0
set_gsetting_uint_if_different org.gnome.desktop.screensaver lock-delay 60
set_gsetting_uint_if_different org.gnome.settings-daemon.plugins.power sleep-inactive-ac-timeout 4800
set_gsetting_if_different org.gnome.settings-daemon.plugins.power sleep-inactive-ac-type suspend
set_audio_toggle_shortcut
set_vpn_toggle_shortcut
set_vt_bounce_hotkey
set_favorite_apps
setup_gnome_extensions

log_info "Setting default applications..."
set_mime_default application/pdf sioyek.desktop
for mime in \
    x-scheme-handler/http \
    x-scheme-handler/https \
    text/html \
    application/xhtml+xml \
    application/xhtml_xml; do
    set_mime_default "$mime" com.microsoft.Edge.desktop
done
set_mimes_from_desktop thunderbird.desktop
for mime in text/calendar application/ics; do
    set_mime_default "$mime" thunderbird.desktop
done
set_mimes_from_desktop mpv.desktop
set_mimes_from_desktop org.nomacs.ImageLounge.desktop

log_info "GNOME preferences applied"
