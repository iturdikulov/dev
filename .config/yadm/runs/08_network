#!/usr/bin/env bash

source "$(dirname -- "${BASH_SOURCE[0]}")/utils.sh"

remove_packages firewalld
install_packages aria2 wget2 curl rsync nfs-common sshfs openssh-server autossh msmtp msmtp-mta whois

log_info "Installing tools"
go install github.com/xjasonlyu/tun2socks/v2@latest
go install github.com/snowie2000/geoview@latest
cargo_binstall tun2proxy

if [[ "${YADM_IS_WSL:-0}" == "1" ]]; then
    log_info "WSL runner detected; skipping Samba and UFW setup"
    exit 0
else
    install_packages samba
    sudo systemctl disable samba-ad-dc
    sudo systemctl mask samba-ad-dc

    # WARN: Enable firewall for debian!
    install_packages ufw
    sudo systemctl enable ufw.service
    sudo ufw default deny incoming
    sudo ufw default allow outgoing

    sudo ufw allow ssh
    sudo ufw allow nfs
    sudo ufw allow samba

    # Strata LLM OpenAI-compatible API (LAN whitelist; key still required by server)
    # Delete legacy Ollama rules if present (numbered delete is brittle across runs — deny+allow is idempotent enough)
    sudo ufw delete allow 11434/tcp >/dev/null 2>&1 || true
    sudo ufw delete allow from 192.168.1.0/24 to any port 11434 proto tcp >/dev/null 2>&1 || true
    sudo ufw allow from 192.168.1.0/24 to any port 8081 proto tcp comment 'Strata LLM LAN'

    sudo ufw enable
    sudo ufw status verbose
fi
