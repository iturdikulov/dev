#!/usr/bin/env bash

source "$(dirname -- "${BASH_SOURCE[0]}")/utils.sh"

set -euo pipefail

APP_VERSION=1.13.7
APP_PACKAGE=obsidian
APP_URL="https://github.com/obsidianmd/obsidian-releases/releases/download/v${APP_VERSION}/obsidian_${APP_VERSION}_amd64.deb"
APP_DEB="/tmp/obsidian-${APP_VERSION}.deb"

if [[ "$(dpkg --print-architecture)" != "amd64" ]]; then
    log_warn "Obsidian .deb is amd64-only; skipping on $(dpkg --print-architecture)"
    exit 0
fi

if package_installed "$APP_PACKAGE"; then
    installed_ver=$(dpkg-query -W -f='${Version}' "$APP_PACKAGE" 2>/dev/null || true)
    if [[ "$installed_ver" == "$APP_VERSION" ]]; then
        log_info "Obsidian ${APP_VERSION} is already installed; skipping download"
        exit 0
    fi
    log_info "Obsidian ${installed_ver:-unknown} installed; upgrading to ${APP_VERSION}"
fi

download_file "$APP_URL" "$APP_DEB"
sudo apt install -y -f "$APP_DEB"
rm -f "$APP_DEB"
