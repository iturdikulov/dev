#!/usr/bin/env bash
# NVIDIA open driver from the NVIDIA CUDA apt repo, pinned to one driver branch.
# Remove the Debian packaged driver first: runs/nvidia_debian_uninstall

source "$(dirname -- "${BASH_SOURCE[0]}")/utils.sh"

check_not_root

NVIDIA_DRIVER_BRANCH=610
# 610 pairs with cuda-toolkit-13-3 (cuda-compat-13-3); 13-4 needs 615
CUDA_TOOLKIT_PACKAGE=cuda-toolkit-13-3

installed_driver="$(dpkg-query -W -f='${Version}' nvidia-driver 2>/dev/null || true)"
# Debian-packaged driver without the CUDA repo: wipe it first. CUDA→CUDA branch bumps are fine.
if [[ -n "$installed_driver" && "$installed_driver" != "$NVIDIA_DRIVER_BRANCH".* ]] && ! package_installed cuda-keyring; then
    log_error "nvidia-driver $installed_driver is installed (Debian stack), run runs/nvidia_debian_uninstall first"
    exit 1
fi

if ! dpkg --print-foreign-architectures | grep -qx i386; then
    sudo dpkg --add-architecture i386
    sudo apt-get update
fi

if ! package_installed cuda-keyring; then
    download_file https://developer.download.nvidia.com/compute/cuda/repos/debian13/x86_64/cuda-keyring_1.1-1_all.deb /tmp/cuda-keyring.deb
    sudo dpkg -i /tmp/cuda-keyring.deb && rm -f /tmp/cuda-keyring.deb
    sudo apt-get update
fi

# Pinning first: otherwise apt picks the newest branch from the repo
install_packages linux-image-amd64 linux-headers-amd64 "nvidia-driver-pinning-$NVIDIA_DRIVER_BRANCH"
# nvidia-open includes nvidia-kernel-open-dkms, CUDA libs, OptiX (libnvoptix1)
install_packages nvidia-open nvidia-driver-libs:i386 "$CUDA_TOOLKIT_PACKAGE" firmware-misc-nonfree

installed_driver="$(dpkg-query -W -f='${Version}' nvidia-driver 2>/dev/null || true)"
if [[ "$installed_driver" != "$NVIDIA_DRIVER_BRANCH".* ]]; then
    log_error "nvidia-driver is $installed_driver, expected $NVIDIA_DRIVER_BRANCH.x after install"
    exit 1
fi
log_info "nvidia-driver $installed_driver"

echo 'GRUB_CMDLINE_LINUX="$GRUB_CMDLINE_LINUX nvidia-drm.modeset=1 nvidia-drm.fbdev=1"' | sudo tee /etc/default/grub.d/nvidia-modeset.cfg
# Open modules: kernel suspend notifiers replace the old nvidia-suspend/hibernate/resume units
# (gone since the 615 packaging; nvidia-suspend-common is only a transitional dummy).
echo 'options nvidia NVreg_PreserveVideoMemoryAllocations=1 NVreg_TemporaryFilePath=/var/tmp NVreg_UseKernelSuspendNotifiers=1' | sudo tee /etc/modprobe.d/nvidia-power-management.conf

# Drop stale enables from older driver packages that pointed at removed unit files
for unit in nvidia-suspend.service nvidia-hibernate.service nvidia-resume.service nvidia-suspend-then-hibernate.service; do
    if systemctl cat "$unit" &>/dev/null; then
        sudo systemctl enable "$unit"
    else
        sudo systemctl disable --now "$unit" 2>/dev/null || true
        sudo rm -f \
            "/etc/systemd/system/systemd-suspend.service.wants/$unit" \
            "/etc/systemd/system/systemd-hibernate.service.wants/$unit" \
            "/etc/systemd/system/systemd-suspend-then-hibernate.service.wants/$unit" \
            "/etc/systemd/system/systemd-hybrid-sleep.service.wants/$unit"
    fi
done
sudo systemctl daemon-reload

sudo update-grub
sudo update-initramfs -u -k all

# Newest kernel from the linux-image-amd64 metapackage - the one grub boots by default
kernel_version="$(dpkg-query -W -f='${Depends}' linux-image-amd64 | sed -E 's/^linux-image-([^ ,]+).*/\1/')"
# Capture first: grep -q closing the pipe early makes dkms fail with SIGPIPE under pipefail
dkms_status="$(dkms status -m nvidia -k "$kernel_version" 2>/dev/null || true)"
if [[ "$dkms_status" == *": installed"* ]]; then
    log_info "nvidia open DKMS module is built for $kernel_version"
else
    log_error "nvidia open DKMS module is not built for $kernel_version, check dkms status before reboot"
fi

log_info "Check after reboot: nvidia-smi (driver $NVIDIA_DRIVER_BRANCH.x), cat /sys/module/nvidia_drm/parameters/modeset (Y), grep PreserveVideoMemoryAllocations /proc/driver/nvidia/params (1)"
log_info "Check https://docs.coolercontrol.org/installation/debian.html for coolercontrol"
