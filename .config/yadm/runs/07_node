#!/usr/bin/env bash

source "$(dirname -- "${BASH_SOURCE[0]}")/utils.sh"

NODE_MAJOR=24
NVM_VERSION=v0.40.7
NVM_INSTALLER_SHA256=066ce4eaf4d78eaa6410433bc9ba58faaba646157cbbed6109153e6c24c5f8a5

check_not_root
check_home_set

NVM_DIR="${NVM_DIR:-$HOME/.nvm}"

install_packages curl

if [[ ! -s "$NVM_DIR/nvm.sh" ]]; then
    log_info "Installing nvm ${NVM_VERSION}"
    installer=$(mktemp)
    trap 'rm -f -- "$installer"' EXIT
    curl -fsSL -o "$installer" "https://raw.githubusercontent.com/nvm-sh/nvm/${NVM_VERSION}/install.sh"
    printf '%s  %s\n' "$NVM_INSTALLER_SHA256" "$installer" | sha256sum --check --status
    bash "$installer"
    rm -f -- "$installer"
    trap - EXIT
fi

# The installer updates the shell profile, but load nvm here so this runner can
# install and select Node.js without requiring a new shell.
load_nvm

log_info "Installing Node.js ${NODE_MAJOR} through nvm"
nvm install "$NODE_MAJOR"
nvm alias default "$NODE_MAJOR"
nvm use default

if [[ "$(node -v)" != "v${NODE_MAJOR}."* ]]; then
    log_error "Expected Node.js ${NODE_MAJOR}.x, got: $(node -v 2>/dev/null || echo missing)"
    exit 1
fi

# Global npm packages (pi, ketch, task, mmdc, …) must not live in the versioned directory:
# `nvm install` of a new patch release creates an empty bin/ and silently drops them. The prefix
# stays inside NVM_DIR because `nvm use` rejects any other location (nvm_die_on_prefix);
# ~/.zshrc, ~/.bashrc and environment.d export the same value.
NPM_GLOBAL_PREFIX="${NPM_GLOBAL_PREFIX:-$NVM_DIR/global}"
export NPM_CONFIG_PREFIX="$NPM_GLOBAL_PREFIX"
ensure_directory "$NPM_GLOBAL_PREFIX/bin"

# PATH must not name the prefix directly: `nvm use` strips every $NVM_DIR/* entry, so profiles
# point at this symlink to its bin/ instead. Only its parent has to exist for `ln -sfn`.
NPM_GLOBAL_BIN_LINK="$HOME/.local/share/npm-global/bin"
ensure_directory "$(dirname "$NPM_GLOBAL_BIN_LINK")"
ln -sfn "$NPM_GLOBAL_PREFIX/bin" "$NPM_GLOBAL_BIN_LINK"

# corepack's own `enable` writes its shims next to the node binary, which is versioned; point it
# at the shared prefix so the yarn shims survive an upgrade. pnpm stays an npm global: it is
# called outside a project (`.zshrc`, `cleanup.sh`), where corepack has no version to resolve.
if command_exists corepack; then
    corepack enable --install-directory "$NPM_GLOBAL_PREFIX/bin" yarn
else
    log_warn "corepack is missing in node $(node -v); yarn will not be available"
fi

npm_prefix=$(npm config get prefix)
if [[ "$npm_prefix" != "$NPM_GLOBAL_PREFIX" ]]; then
    log_error "npm prefix is ${npm_prefix}, expected ${NPM_GLOBAL_PREFIX}"
    exit 1
fi

# Globals installed by the old scheme stay in <version>/bin and shadow the shared ones on PATH,
# so an upgrade would look like a rollback of whatever they contain.
version_bin="$NVM_DIR/versions/node/$(nvm version default)/bin"
leftovers=()
for entry in "$version_bin"/*; do
    case "$(basename "$entry")" in
        node | npm | npx | corepack | corepack-shims) continue ;;
    esac
    leftovers+=("$(basename "$entry")")
done
if (( ${#leftovers[@]} )); then
    log_warn "Globals left in the versioned bin (${version_bin}): ${leftovers[*]}"
    log_warn "They vanish on the next node upgrade; re-run the runners that own them (utils.sh npm_global_ensure)"
fi

# GUI sessions (Obsidian, .desktop launchers) read PATH from environment.d, which cannot
# express nvm's versioned directory. Expose the current default through a stable symlink
# so an upgrade moves the path instead of leaving a dead one behind.
NODE_CURRENT_LINK="$HOME/.local/share/nvm-current"
ensure_directory "$(dirname "$NODE_CURRENT_LINK")"
ln -sfn "$(dirname "$(dirname "$(nvm which default)")")" "$NODE_CURRENT_LINK"

# Corepack writes its shims as symlinks into the versioned directory; route them through the
# stable nvm-current link so they keep resolving after that version is removed.
COREPACK_DIST="$NODE_CURRENT_LINK/lib/node_modules/corepack/dist"
for shim in yarn yarnpkg; do
    if [[ -e "$COREPACK_DIST/$shim.js" ]]; then
        ln -sfn "$COREPACK_DIST/$shim.js" "$NPM_GLOBAL_PREFIX/bin/$shim"
    else
        log_warn "no corepack entry point at ${COREPACK_DIST}/${shim}.js: ${shim} may break after a node upgrade"
    fi
done

log_info "Node.js installed: $(node -v) (npm $(npm -v)); default: $(nvm version default)"
log_info "npm globals prefix: ${npm_prefix}"
log_info "GUI link: ${NODE_CURRENT_LINK} -> $(readlink -f "$NODE_CURRENT_LINK")"
