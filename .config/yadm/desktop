#!/usr/bin/env bash

set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
cd "$script_dir"
# shellcheck source=runs/utils.sh
source "$script_dir/runs/utils.sh"
# shellcheck source=runs/nfs_utils.sh
source "$script_dir/runs/nfs_utils.sh"

yadm config local.class desktop
yadm alt

nfs_setup_server \
    personal \
    NFS_PERSONAL_SERVER_IP \
    /etc/exports.d/yadm-personal.exports \
    /tmp/nfs-personal-client.sh \
    ro \
    "$HOME/Pictures/personal:Pictures/personal" \
    "$HOME/Videos/personal:Videos/personal"

sudo apt install -y firmware-amd-graphics firmware-iwlwifi firmware-misc-nonfree i2c-tools libgl1-mesa-dri libglx-mesa0 mesa-vulkan-drivers power-profiles-daemon
sudo usermod -a -G render,video "$LOGNAME" # Add the current user to the render, video and printer groups

# Add nct6687d for MS-7C95-B550M-PRO-VDH
kernel_release="$(uname -r)"
if find "/lib/modules/$kernel_release" -type f -iname 'nct6687d*.ko*' -print -quit 2>/dev/null | grep -q .; then
    log_info "nct6687d is already available for kernel $kernel_release"
else
    cd /tmp || exit 1
    if [[ ! -d /tmp/nct6687d ]]; then
        git clone https://github.com/Fred78290/nct6687d /tmp/nct6687d
    elif [[ ! -d /tmp/nct6687d/.git ]]; then
        log_error "/tmp/nct6687d exists but is not a Git clone"
        exit 1
    fi
    cd /tmp/nct6687d || exit 1
    make deb
    sudo dpkg -i ../nct6687d-dkms_*.deb
fi

if command_exists modprobe; then
    sudo modprobe nct6687d || log_warn "Could not load nct6687d for kernel $kernel_release"
else
    log_warn "modprobe is unavailable; log in again or reboot after installing nct6687d"
fi

# Copy config if not exits
if ! [ -e /etc/sensors.d/MS-7C95-B550M-PRO-VDH.conf ]; then
    sudo ln "$script_dir/desktop_conf/etc/sensors.d/MS-7C95-B550M-PRO-VDH.conf" /etc/sensors.d/
    echo "Sensors config linked successfully."
fi

# Load i2c-dev at boot (/dev/i2c-*)
if ! [ -e /etc/modules-load.d/i2c-dev.conf ]; then
    sudo apt install -y i2c-tools
    sudo ln "$script_dir/desktop_conf/etc/modules-load.d/i2c-dev.conf" /etc/modules-load.d/
    sudo modprobe i2c-dev || true
    echo "modules-load.d i2c-dev linked successfully."
fi

"$script_dir/run_runner.sh" --profile desktop

"$script_dir/sync.sh"

log_info "NFS export is active for a client user with UID $(id -u) and GID $(id -g)"
log_info "NFS client installer: /tmp/nfs-personal-client.sh"
log_info "Copy it to the client: scp /tmp/nfs-personal-client.sh <client-host>:/tmp/"
log_info "Run it on the client: ssh -t <client-host> 'bash /tmp/nfs-personal-client.sh'"
