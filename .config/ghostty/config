# Run `ghostty +show-config --default --docs` to view a list of
# all available config options and their default values.
#
# Additionally, each config option is also explained in detail
# on Ghostty's website, at https://ghostty.org/docs/config.
font-family = IosevkaTerm Nerd Font
font-size = 16.6
config-file = "?laptop.conf"

# az-right: файла az-right.conf нет — есть только
# az-right.conf##class.com.mitchellh.ghostty.az
# Ghostty подхватывает ##-вариант, когда класс окна совпадает
# (см. StartupWMClass в com.mitchellh.ghostty.az.desktop).
# Обычный Ghostty класс не матчит → include пропускается (?).
config-file = "?az-right.conf"

config-file = "?keybinds.conf"
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor
command = tmux new-session
theme = kanso-zen
gtk-custom-css = tab-style.css
gtk-titlebar = false
maximize = true
clipboard-paste-protection = false
