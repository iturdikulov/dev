#!/usr/bin/env zsh
# Проверяет конфликтующие миграции до запуска git merge.

main() {
    local merge_source=""
    local argument
    for argument in "$@"; do
        [[ "$argument" == "--" ]] && break
        [[ "$argument" == -* ]] && continue

        if [[ -n "$merge_source" ]]; then
            command git merge "$@"
            return
        fi
        merge_source="$argument"
    done

    if [[ -z "$merge_source" ]] || ! command git rev-parse --verify -q "${merge_source}^{commit}" >/dev/null; then
        command git merge "$@"
        return
    fi

    local head source_commit merge_base next_version answer duplicate_output
    local repository_root package_name service_name monorepo_root branch_name ticket
    local -a duplicate_files renamed_files
    head=$(command git rev-parse --verify HEAD) || return
    source_commit=$(command git rev-parse --verify "${merge_source}^{commit}") || return
    merge_base=$(command git merge-base "$head" "$source_commit") || {
        print -u2 "Не найден общий предок для HEAD и $merge_source."
        return 1
    }
    duplicate_output=$(LC_ALL=C comm -12 \
        <(
            {
                # Старые миграции нельзя перенумеровывать: они могли уже выполниться.
                command git diff --diff-filter=A --name-only "$merge_base" -- migrations
                command git ls-files --others --exclude-standard -- migrations
            } | sed -nE '/^migrations\/v[0-9]+\.py$/p' | LC_ALL=C sort -u
        ) \
        <(
            command git diff --diff-filter=A --name-only "$merge_base" "$source_commit" -- migrations \
                | sed -nE '/^migrations\/v[0-9]+\.py$/p' \
                | LC_ALL=C sort -u
        ))

    if [[ -z "$duplicate_output" ]]; then
        command git merge "$@"
        return
    fi
    duplicate_files=("${(@f)duplicate_output}")

    next_version=$(
        {
            command git ls-files --cached --others --exclude-standard -- migrations
            command git ls-tree -r --name-only "$source_commit" -- migrations
        } | sed -nE 's|^migrations/v([0-9]+)\.py$|\1|p' | sort -n | tail -n 1 | awk '{ print $1 + 1 }'
    )
    print -u2 "Найдены новые миграции с одинаковыми номерами в обеих ветках:"
    print -u2 -- "${(F)duplicate_files}"
    print -u2 "Будут выполнены:"
    local file new_file
    for file in "${duplicate_files[@]}"; do
        new_file="migrations/v${next_version}.py"
        renamed_files+=("$new_file")
        print -u2 "  git mv $file $new_file"
        ((next_version++))
    done
    print -u2 "  git add -- ${(j: :)renamed_files}"

    if [[ ! -t 0 ]]; then
        print -u2 "Переименование не выполнено: требуется интерактивный терминал."
        return 1
    fi
    read -r "answer?Выполнить переименование и git add? [Y/n] "
    print
    if [[ -z "$answer" || "$answer" == [Yy] ]]; then
        if ! command git diff --cached --quiet; then
            print -u2 "Переименование не выполнено: индекс уже содержит изменения. Закоммитьте или уберите их из индекса."
            return 1
        fi
        branch_name=$(command git symbolic-ref --quiet --short HEAD) || {
            print -u2 "Переименование не выполнено: HEAD не указывает на ветку с меткой AS-..."
            return 1
        }
        ticket=$(print -r -- "$branch_name" | sed -nE 's/.*(AS-[0-9]+).*/\1/p' | head -n 1)
        if [[ -z "$ticket" ]]; then
            print -u2 "Переименование не выполнено: в имени ветки '$branch_name' не найдена метка AS-..."
            return 1
        fi
        local index
        for ((index = 1; index <= ${#duplicate_files[@]}; index++)); do
            command git mv -- "${duplicate_files[$index]}" "${renamed_files[$index]}" || return
        done
        command git add -- "${renamed_files[@]}" || return
        command git commit -m "$ticket - переименование пересекающихся миграций" || return
        # Промежуточный commit освобождает номер до merge, --no-edit не открывает редактор в этом сценарии.
        command git merge --no-edit "$@" || return

        repository_root=$(command git rev-parse --show-toplevel) || return
        package_name=${repository_root:t}
        service_name=${package_name%-backend}
        monorepo_root=${repository_root:h:h}

        if command git rev-parse --verify -q MERGE_HEAD >/dev/null; then
            print -u2 "Merge ожидает коммита; dc:renumber не запущен. После commit выполните:"
            print -u2 "  cd $monorepo_root && task dc:renumber -- $merge_source $service_name"
            return 1
        fi

        if [[ "$package_name" != *-backend ]]; then
            print -u2 "dc:renumber не запущен: текущий репозиторий не является packages/<service>-backend."
            return 1
        fi
        if [[ ! -f "$monorepo_root/taskfile.yml" ]]; then
            print -u2 "dc:renumber не запущен: не найден $monorepo_root/taskfile.yml."
            return 1
        fi

        print "Merge завершён. Запускается dc:renumber для $service_name."
        (
            cd "$monorepo_root" || exit
            command task dc:renumber -- "$merge_source" "$service_name"
        )
        return
    fi
    return 1
}

main "$@"
